<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- falar com a app do PC na rede local (HTTP simples, só na mesma rede Wi-Fi) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- ler o QR do PC -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- ligar a depuração sem fios sozinha ao arrancar (opcional, desligado por omissão) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Ligar/desligar a «Depuração sem fios». Não se pede ao utilizador: só existe se a app do PC a der, uma vez, com
         «adb shell pm grant app.ligaradb android.permission.WRITE_SECURE_SETTINGS». Sem ela a app abre as definições do Android. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_ligar"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/rede"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- o QR do PC é um link «ligaradb://pc?…»: lido pela câmara normal do telemóvel (ou qualquer leitor), abre esta app -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ligaradb" android:host="pc" />
            </intent-filter>
        </activity>

        <!-- o leitor de QR da biblioteca, sempre na vertical -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            tools:replace="screenOrientation" />

        <!-- botão nas definições rápidas: liga/desliga a depuração sem fios com um toque -->
        <service
            android:name=".BotaoRapido"
            android:exported="true"
            android:icon="@drawable/ic_ligar"
            android:label="@string/botao_rapido"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- vigia da «Depuração sem fios» (gatilho de conteúdo do JobScheduler) -->
        <service
            android:name=".Vigia"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".AoArrancar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
